import java_cup.runtime.*;
import java.util.ArrayList;
import java.util.List;

parser code {:

    public List<String> erroresSintacticos = new ArrayList<>();

    private final TablaSimbolos tablaSimbolos = new TablaSimbolos();

    public List<String> erroresSemanticos = new ArrayList<>();

    public void registrarSimbolo(
        String nombre,
        String tipo,
        int linea,
        String categoria
    ) {
        boolean agregado = tablaSimbolos.agregarSimbolo(
            nombre, tipo, linea, categoria
        );

        if (!agregado) {
            String mensaje =
                "[ERROR SEMANTICO] Linea " + linea
                + ": el identificador '" + nombre
                + "' ya fue declarado en este ambito.";

            erroresSemanticos.add(mensaje);
        }
    }

    /**
     * Comprueba que un identificador exista en un ambito accesible.
     *
     * @param nombre Nombre del identificador.
     * @param linea Linea donde se utiliza.
     */
    public void validarIdentificador(String nombre, int linea) {
        TablaSimbolos.Simbolo simbolo =
            tablaSimbolos.buscarSimbolo(nombre);

        if (simbolo == null) {
            String mensaje =
                "[ERROR SEMANTICO] Linea " + linea
                + ": el identificador '" + nombre
                + "' no ha sido declarado o esta fuera de su ambito.";

            erroresSemanticos.add(mensaje);
        }
    }

    public void validarTipoAsignacion(
        String nombre,
        String tipoDeclarado,
        String tipoExpresion,
        int linea
    ) {
        // Todavia no conocemos el tipo de todas las expresiones.
        if (tipoExpresion == null) {
            return;
        }

        if (!tipoDeclarado.equals(tipoExpresion)) {
            String mensaje =
                "[ERROR SEMANTICO] Linea " + linea
                + ": no se puede asignar un valor de tipo '"
                + tipoExpresion
                + "' a la variable '" + nombre
                + "' de tipo '" + tipoDeclarado + "'.";

            erroresSemanticos.add(mensaje);
        }
    }

    public String validarOperacionAritmetica(
        String tipoIzquierdo,
        String tipoDerecho,
        String operador,
        int linea
    ) {
        if (tipoIzquierdo == null || tipoDerecho == null) {
            return null;
        }

        boolean izquierdoNumerico =
            tipoIzquierdo.equals("int") || tipoIzquierdo.equals("float");

        boolean derechoNumerico =
            tipoDerecho.equals("int") || tipoDerecho.equals("float");

        boolean tiposValidos;

        switch (operador) {
            case "//":
            case "mod":
            case "pot":
                tiposValidos =
                    tipoIzquierdo.equals("int")
                    && tipoDerecho.equals("int");
                break;

            default:
                tiposValidos = izquierdoNumerico && derechoNumerico;
                break;
        }

        if (!tiposValidos) {
            erroresSemanticos.add(
                "[ERROR SEMANTICO] Linea " + linea
                + ": el operador '" + operador
                + "' no admite operandos de tipo '"
                + tipoIzquierdo + "' y '"
                + tipoDerecho + "'."
            );
            return null;
        }

        switch (operador) {
            case "/":
                return "float";

            case "//":
            case "mod":
            case "pot":
                return "int";

            default:
                if (tipoIzquierdo.equals("float")
                    || tipoDerecho.equals("float")) {
                    return "float";
                }
                return "int";
        }
    }

    public String validarIncrementoDecremento(
        String nombre,
        String operador,
        int linea
    ) {
        TablaSimbolos.Simbolo simbolo =
            tablaSimbolos.buscarSimbolo(nombre);

        if (simbolo == null) {
            validarIdentificador(nombre, linea);
            return null;
        }

        String tipo = simbolo.getTipo();

        if (!tipo.equals("int") && !tipo.equals("float")) {
            erroresSemanticos.add(
                "[ERROR SEMANTICO] Linea " + linea
                + ": el operador '" + operador
                + "' solo puede aplicarse a variables int o float."
            );
            return null;
        }

        return tipo;
    }

    public boolean huboErrorSemantico() {
        return !erroresSemanticos.isEmpty();
    }

    public TablaSimbolos getTablaSimbolos() {
        return tablaSimbolos;
    }

    public boolean huboErrorSintactico() {
        return !erroresSintacticos.isEmpty();
    }

    public void syntax_error(Symbol s) {

        String lexema =
            (s != null && s.value != null)
            ? String.valueOf(s.value)
            : "EOF";

        int linea =
            (s != null && s.left >= 0)
            ? s.left
            : -1;

        int columna =
            (s != null && s.right >= 0)
            ? s.right
            : -1;

        String mensaje;

        if (s != null && s.sym == sym.EOF) {
            mensaje =
                "[ERROR SINTACTICO] Linea "
                + linea
                + ", columna "
                + columna
                + ": fin de archivo inesperado.";
        } else {
            mensaje =
                "[ERROR SINTACTICO] Linea "
                + linea
                + ", columna "
                + columna
                + ": token inesperado -> '"
                + lexema
                + "'";
        }

        System.err.println(mensaje);
        erroresSintacticos.add(mensaje);
    }

    public void unrecovered_syntax_error(Symbol s) {

        int linea =
            (s != null && s.left >= 0)
            ? s.left
            : -1;

        int columna =
            (s != null && s.right >= 0)
            ? s.right
            : -1;

        String mensaje =
            "[ERROR SINTACTICO IRRECUPERABLE] Linea "
            + linea
            + ", columna "
            + columna
            + ": no se pudo continuar el analisis.";

        System.err.println(mensaje);
        erroresSintacticos.add(mensaje);
    }

:};


/* ==========================================
   TERMINALES
   ========================================== */

terminal INT, FLOAT, BOOL, CHAR, STRING, VOID;

terminal PRINCIPAL, IF, ELIF, ELSE, WHILE, FOR;
terminal RETURN, BREAK, VAL, READ, WRITE;

terminal INCREMENTO, DECREMENTO;
terminal DIVISION_ENTERA;

terminal SUMA, RESTA;
terminal MULTIPLICACION, DIVISION;
terminal MODULO, POTENCIA;

terminal MENOR_IGUAL, MAYOR_IGUAL;
terminal IGUAL, DIFERENTE;
terminal MENOR, MAYOR;

terminal AND, OR, NOT;

terminal ASIGNACION;

terminal BLOQUE_INI, BLOQUE_FIN;
terminal PAR_INI, PAR_FIN;
terminal COR_INI, COR_FIN;
terminal FIN_EXPR;
terminal COMA;

terminal LIT_BOOL;
terminal LIT_CHAR;
terminal LIT_STRING;
terminal LIT_FLOAT;
terminal LIT_INT;

terminal ID;


/* ==========================================
   NO TERMINALES
   ========================================== */

non terminal PROGRAMA;

non terminal LISTA_ELEMENTOS;
non terminal ELEMENTO_PROGRAMA;

non terminal DECLARACION_GLOBAL;

non terminal FUNCION_MAIN;

non terminal DECLARACION_FUNCION;

non terminal String TIPO_RETORNO;
non terminal String TIPO;

non terminal PARAMETROS;
non terminal PARAMETRO;

non terminal ARGUMENTOS;
non terminal ARGUMENTO;

non terminal LLAMADA_FUNCION;

non terminal BLOQUE;
non terminal BLOQUE_FUNCION;

non terminal LISTA_SENTENCIAS;
non terminal SENTENCIA;

non terminal DECLARACION_VAR_SIMPLE;
non terminal DECLARACION_VAR_ASIGNADA;

non terminal ARREGLO;

non terminal ASIGNACION_ARREGLO;
non terminal String ACCESO_ARREGLO;

non terminal TAMANO_ARREGLO;
non terminal LISTA_EXPRESIONES;
non terminal String INDICE;

non terminal ASIGNACION_VAR;
non terminal ASIGNACION_VAR_SIN_FIN;

non terminal EXPR_SIN_ASIGNACION;

non terminal String EXPRESION;


/* ==========================================
   EXPRESIONES ARITMETICAS
   ========================================== */

non terminal OP_NEG;

non terminal String EXPR_NEGATIVO;
non terminal String EXPR_INCREMENTO;
non terminal String EXPR_DECREMENTO;

non terminal String OPERANDO;

non terminal String EXPR_POTENCIA;
non terminal String EXPR_SUMA_RESTA;
non terminal String EXPR_MULT_DIV;
non terminal String EXPR_ARITMETICA;


/* ==========================================
   EXPRESIONES RELACIONALES
   ========================================== */

non terminal String OPERANDO_RELACIONAL;
non terminal String EXPR_RELACIONAL;


/* ==========================================
   EXPRESIONES LOGICAS
   ========================================== */

non terminal String OPERANDO_LOGICO;
non terminal String EXPR_LOGICA;
non terminal String EXPR_NEGACION_LOGICA;
non terminal String GRUPO_PARENTESIS;


/* ==========================================
   CONTROL DE FLUJO
   ========================================== */

non terminal SENTENCIA_IF;
non terminal SENTENCIA_IF_RESTO;
non terminal SENTENCIA_ELIF_LISTA;

non terminal SENTENCIA_WHILE;

non terminal SENTENCIA_FOR;
non terminal SENTENCIA_FOR_INIT;
non terminal SENTENCIA_FOR_INCREMENTO;


/* ==========================================
   ENTRADA Y SALIDA
   ========================================== */

non terminal SENTENCIA_READ;
non terminal SENTENCIA_WRITE;
non terminal OPERANDO_WRITE;


/* ==========================================
   RETURN Y BREAK
   ========================================== */

non terminal SENTENCIA_RETURN;
non terminal SENTENCIA_BREAK;


/* ==========================================
   SIMBOLO INICIAL
   ========================================== */

start with PROGRAMA;


/* ==========================================
   1. ESTRUCTURA DEL PROGRAMA
   ========================================== */

PROGRAMA ::=
      FUNCION_MAIN
    ;

PROGRAMA ::=
      LISTA_ELEMENTOS FUNCION_MAIN
    ;


LISTA_ELEMENTOS ::=
      ELEMENTO_PROGRAMA
    ;

LISTA_ELEMENTOS ::=
      ELEMENTO_PROGRAMA LISTA_ELEMENTOS
    ;


ELEMENTO_PROGRAMA ::=
      DECLARACION_GLOBAL
    ;

ELEMENTO_PROGRAMA ::=
      DECLARACION_FUNCION
    ;

ELEMENTO_PROGRAMA ::=
      error FIN_EXPR
    ;


/* ==========================================
   2. DECLARACIONES GLOBALES
   ========================================== */

DECLARACION_GLOBAL ::=
      DECLARACION_VAR_SIMPLE
    ;

DECLARACION_GLOBAL ::=
      DECLARACION_VAR_ASIGNADA
    ;

DECLARACION_GLOBAL ::=
      ARREGLO
    ;


/* ==========================================
   3. FUNCION PRINCIPAL
   ========================================== */

FUNCION_MAIN ::=
      VOID PRINCIPAL PAR_INI PAR_FIN
      {: tablaSimbolos.abrirAmbito("principal"); :}
      BLOQUE_FUNCION
      {: tablaSimbolos.cerrarAmbito(); :}
    ;


/* ==========================================
   4. TIPOS
   ========================================== */

TIPO ::=
      INT    {: RESULT = "int"; :}
    | FLOAT  {: RESULT = "float"; :}
    | BOOL   {: RESULT = "bool"; :}
    | CHAR   {: RESULT = "char"; :}
    | STRING {: RESULT = "string"; :}
    ;

TIPO_RETORNO ::=
      INT   {: RESULT = "int"; :}
    | FLOAT {: RESULT = "float"; :}
    | CHAR  {: RESULT = "char"; :}
    | BOOL  {: RESULT = "bool"; :}
    ;


/* ==========================================
   5. PARAMETROS
   ========================================== */

PARAMETRO ::=
      TIPO:tipo ID:id
      {: registrarSimbolo((String) id, tipo, idleft, "parametro"); :}
    ;


PARAMETROS ::=
      PARAMETRO
    ;

PARAMETROS ::=
      PARAMETRO COMA PARAMETROS
    ;


/* ==========================================
   6. FUNCIONES
   ========================================== */

DECLARACION_FUNCION ::=
      TIPO_RETORNO:tipo ID:id PAR_INI
      {:
          registrarSimbolo((String) id, (String) tipo, idleft, "funcion");
          tablaSimbolos.abrirAmbito("funcion " + id);
      :}
      PAR_FIN BLOQUE_FUNCION
      {: tablaSimbolos.cerrarAmbito(); :}
    ;

DECLARACION_FUNCION ::=
      TIPO_RETORNO:tipo ID:id PAR_INI
      {:
          registrarSimbolo((String) id, (String) tipo, idleft, "funcion");
          tablaSimbolos.abrirAmbito("funcion " + id);
      :}
      PARAMETROS PAR_FIN BLOQUE_FUNCION
      {: tablaSimbolos.cerrarAmbito(); :}
    ;


/* ==========================================
   7. ARGUMENTOS
   ========================================== */

ARGUMENTO ::=
      EXPRESION
    ;


ARGUMENTOS ::=
      ARGUMENTO
    ;

ARGUMENTOS ::=
      ARGUMENTO COMA ARGUMENTOS
    ;


/* ==========================================
   8. LLAMADA A FUNCION
   ========================================== */

LLAMADA_FUNCION ::=
      ID PAR_INI PAR_FIN
    ;

LLAMADA_FUNCION ::=
      ID PAR_INI ARGUMENTOS PAR_FIN
    ;


/* ==========================================
   9. BLOQUES
   ========================================== */

BLOQUE ::=
      BLOQUE_INI {: tablaSimbolos.abrirAmbitoBloque(); :}
      LISTA_SENTENCIAS BLOQUE_FIN
      {: tablaSimbolos.cerrarAmbito(); :}
    ;

BLOQUE_FUNCION ::=
      BLOQUE_INI LISTA_SENTENCIAS BLOQUE_FIN
    ;


LISTA_SENTENCIAS ::=
      /* vacio */
    ;

LISTA_SENTENCIAS ::=
      SENTENCIA LISTA_SENTENCIAS
    ;


/* ==========================================
   10. SENTENCIAS
   ========================================== */

SENTENCIA ::=
      DECLARACION_VAR_SIMPLE
    ;

SENTENCIA ::=
      DECLARACION_VAR_ASIGNADA
    ;

SENTENCIA ::=
      ASIGNACION_VAR
    ;

SENTENCIA ::=
      ARREGLO
    ;

SENTENCIA ::=
      ASIGNACION_ARREGLO
    ;

SENTENCIA ::=
      EXPR_SIN_ASIGNACION
    ;

SENTENCIA ::=
      SENTENCIA_RETURN
    ;

SENTENCIA ::=
      SENTENCIA_BREAK
    ;

SENTENCIA ::=
      SENTENCIA_READ
    ;

SENTENCIA ::=
      SENTENCIA_WRITE
    ;

SENTENCIA ::=
      SENTENCIA_IF
    ;

SENTENCIA ::=
      SENTENCIA_WHILE
    ;

SENTENCIA ::=
      SENTENCIA_FOR
    ;

SENTENCIA ::=
      BLOQUE
    ;


/* ==========================================
   RECUPERACION EN MODO PANICO
   ========================================== */

SENTENCIA ::=
      error FIN_EXPR
    ;


/* ==========================================
   11. EXPRESION GENERAL
   ========================================== */

EXPRESION ::=
      EXPR_ARITMETICA:ea
      {: RESULT = ea; :}
    ;

EXPRESION ::=
      EXPR_RELACIONAL
      {: RESULT = "bool"; :}
    ;

EXPRESION ::=
      EXPR_LOGICA
      {: RESULT = "bool"; :}
    ;

EXPRESION ::=
      EXPR_NEGACION_LOGICA
      {: RESULT = "bool"; :}
    ;


//Si el profesor NO permite que estos literales sean usados
// EXPRESION ::=
//       LIT_BOOL
//       {: RESULT = "bool"; :}
//     ;
//
// EXPRESION ::=
//       LIT_CHAR
//       {: RESULT = "char"; :}
//     ;
//
// EXPRESION ::=
//       LIT_STRING
//       {: RESULT = "string"; :}
//     ;
//

// OPERANDO_RELACIONAL ::=
//       LIT_BOOL
//       {: RESULT = "bool"; :}
//     ;
//
// OPERANDO_RELACIONAL ::=
//       LIT_CHAR
//       {: RESULT = "char"; :}
//     ;
//
// NOTA: La siguiente producción se eliminó de OPERANDO_LOGICO
// para evitar conflictos. Si se necesita, descomentarla:
//
// OPERANDO_LOGICO ::=
//       LIT_BOOL
//       {: RESULT = "bool"; :}
//     ;


/* ==========================================
   12. EXPRESIONES ARITMETICAS
   ========================================== */


/* ---- Operador negativo ---- */

OP_NEG ::=
      RESTA
    ;


/* ---- Expresion negativa ---- */

EXPR_NEGATIVO ::=
      OP_NEG LIT_INT
      {: RESULT = "int"; :}
    | OP_NEG LIT_FLOAT
      {: RESULT = "float"; :}
    ;


/* ---- Incremento ---- */

EXPR_INCREMENTO ::=
      ID:id INCREMENTO
      {:
          RESULT = validarIncrementoDecremento(
              (String) id, "++", idleft
          );
      :}
    ;


/* ---- Decremento ---- */

EXPR_DECREMENTO ::=
      ID:id DECREMENTO
      {:
          RESULT = validarIncrementoDecremento(
              (String) id, "--", idleft
          );
      :}
    ;


/* ---- Operandos ---- */

OPERANDO ::=
      ID:id
      {:
          validarIdentificador((String) id, idleft);

          TablaSimbolos.Simbolo simbolo =
              tablaSimbolos.buscarSimbolo((String) id);

          RESULT = (simbolo != null)
              ? simbolo.getTipo()
              : null;
      :}

    | LIT_INT
      {: RESULT = "int"; :}

    | LIT_FLOAT
      {: RESULT = "float"; :}

    // PENDIENTE: Consultar con el profesor si estos literales
    // deben ser permitidos en operandos aritméticos
    | LIT_BOOL
      {: RESULT = "bool"; :}

    | LIT_STRING
      {: RESULT = "string"; :}

    | LIT_CHAR
      {: RESULT = "char"; :}

    | ACCESO_ARREGLO:aa
      {: RESULT = aa; :}

    | GRUPO_PARENTESIS:gp
      {: RESULT = gp; :}

    | EXPR_NEGATIVO:en
      {: RESULT = en; :}

    | EXPR_INCREMENTO:ei
      {: RESULT = ei; :}

    | EXPR_DECREMENTO:ed
      {: RESULT = ed; :}

    | LLAMADA_FUNCION
      {: RESULT = null; :}
    ;


/* ---- Potencia: mayor precedencia ---- */

EXPR_POTENCIA ::=
      OPERANDO:op
      {: RESULT = op; :}

    | OPERANDO:izq POTENCIA EXPR_POTENCIA:der
      {:
          RESULT = validarOperacionAritmetica(
              izq, der, "pot", izqleft
          );
      :}
    ;


/* ---- Suma y resta ---- */

EXPR_SUMA_RESTA ::=
      EXPR_POTENCIA:ep
      {: RESULT = ep; :}

    | EXPR_SUMA_RESTA:izq SUMA EXPR_POTENCIA:der
      {:
          RESULT = validarOperacionAritmetica(
              izq, der, "+", izqleft
          );
      :}

    | EXPR_SUMA_RESTA:izq RESTA EXPR_POTENCIA:der
      {:
          RESULT = validarOperacionAritmetica(
              izq, der, "-", izqleft
          );
      :}
    ;


/* ---- Multiplicacion y division ---- */

EXPR_MULT_DIV ::=
      EXPR_SUMA_RESTA:esr
      {: RESULT = esr; :}

    | EXPR_MULT_DIV:izq MULTIPLICACION EXPR_SUMA_RESTA:der
      {:
          RESULT = validarOperacionAritmetica(
              izq, der, "*", izqleft
          );
      :}

    | EXPR_MULT_DIV:izq DIVISION EXPR_SUMA_RESTA:der
      {:
          RESULT = validarOperacionAritmetica(
              izq, der, "/", izqleft
          );
      :}

    | EXPR_MULT_DIV:izq DIVISION_ENTERA EXPR_SUMA_RESTA:der
      {:
          RESULT = validarOperacionAritmetica(
              izq, der, "//", izqleft
          );
      :}
    ;


/* ---- Modulo: menor precedencia ---- */

EXPR_ARITMETICA ::=
      EXPR_MULT_DIV:emd
      {: RESULT = emd; :}

    | EXPR_ARITMETICA:izq MODULO EXPR_MULT_DIV:der
      {:
          RESULT = validarOperacionAritmetica(
              izq, der, "mod", izqleft
          );
      :}
    ;


/* ==========================================
   13. EXPRESIONES RELACIONALES
   ========================================== */

/* Operandos relacionales generales */

OPERANDO_RELACIONAL ::=
      EXPR_ARITMETICA:ea
      {: RESULT = ea; :}
    ;

OPERANDO_RELACIONAL ::=
      EXPR_RELACIONAL
      {: RESULT = "bool"; :}
    ;

OPERANDO_RELACIONAL ::=
      EXPR_LOGICA
      {: RESULT = "bool"; :}
    ;

OPERANDO_RELACIONAL ::=
      EXPR_NEGACION_LOGICA:enl
      {: RESULT = enl; :}
    ;

/* Menor */

EXPR_RELACIONAL ::=
      COR_INI OPERANDO_RELACIONAL COR_FIN
      MENOR
      COR_INI OPERANDO_RELACIONAL COR_FIN
    ;

/* Menor o igual */

EXPR_RELACIONAL ::=
      COR_INI OPERANDO_RELACIONAL COR_FIN
      MENOR_IGUAL
      COR_INI OPERANDO_RELACIONAL COR_FIN
    ;

/* Mayor */

EXPR_RELACIONAL ::=
      COR_INI OPERANDO_RELACIONAL COR_FIN
      MAYOR
      COR_INI OPERANDO_RELACIONAL COR_FIN
    ;

/* Mayor o igual */

EXPR_RELACIONAL ::=
      COR_INI OPERANDO_RELACIONAL COR_FIN
      MAYOR_IGUAL
      COR_INI OPERANDO_RELACIONAL COR_FIN
    ;

/* Igual */

EXPR_RELACIONAL ::=
      COR_INI OPERANDO_RELACIONAL COR_FIN
      IGUAL
      COR_INI OPERANDO_RELACIONAL COR_FIN
    ;

/* Diferente */

EXPR_RELACIONAL ::=
      COR_INI OPERANDO_RELACIONAL COR_FIN
      DIFERENTE
      COR_INI OPERANDO_RELACIONAL COR_FIN
    ;


/* ==========================================
   14. EXPRESIONES LOGICAS
   ========================================== */

OPERANDO_LOGICO ::=
      EXPR_ARITMETICA:ea
      {: RESULT = ea; :}
    ;

OPERANDO_LOGICO ::=
      EXPR_RELACIONAL
      {: RESULT = "bool"; :}
    ;

OPERANDO_LOGICO ::=
      EXPR_NEGACION_LOGICA:enl
      {: RESULT = enl; :}
    ;

OPERANDO_LOGICO ::=
      EXPR_LOGICA:el
      {: RESULT = el; :}
    ;


GRUPO_PARENTESIS ::=
      PAR_INI OPERANDO_LOGICO:ol PAR_FIN
      {: RESULT = ol; :}
    ;


/* ---- AND ---- */

EXPR_LOGICA ::=
      GRUPO_PARENTESIS
      AND
      GRUPO_PARENTESIS
    ;


/* ---- OR ---- */

EXPR_LOGICA ::=
      GRUPO_PARENTESIS
      OR
      GRUPO_PARENTESIS
    ;


/* ---- NOT ---- */

EXPR_NEGACION_LOGICA ::=
      NOT GRUPO_PARENTESIS:gp
      {: RESULT = gp; :}
    ;


/* ==========================================
   15. VARIABLES Y ASIGNACIONES
   ========================================== */

DECLARACION_VAR_SIMPLE ::=
      VAL TIPO:tipo ID:id FIN_EXPR
      {: registrarSimbolo((String) id, tipo, idleft, "variable"); :}
    ;


DECLARACION_VAR_ASIGNADA ::=
      VAL TIPO:tipo ID:id ASIGNACION EXPRESION:expr FIN_EXPR
      {:
          registrarSimbolo((String) id, tipo, idleft, "variable");
          validarTipoAsignacion((String) id, tipo, expr, idleft);
      :}
    ;


ASIGNACION_VAR ::=
      ID:id ASIGNACION EXPRESION FIN_EXPR
      {: validarIdentificador((String) id, idleft); :}
    ;


ASIGNACION_VAR_SIN_FIN ::=
      ID:id ASIGNACION EXPRESION
      {: validarIdentificador((String) id, idleft); :}
    ;


EXPR_SIN_ASIGNACION ::=
      EXPRESION FIN_EXPR
    ;


/* ==========================================
   16. ARREGLOS
   ========================================== */

LISTA_EXPRESIONES ::=
      EXPRESION
    | EXPRESION COMA LISTA_EXPRESIONES
    ;

TAMANO_ARREGLO ::=
      LIT_INT
    ;

ARREGLO ::=
      VAL TIPO:tipo ID:id COR_INI TAMANO_ARREGLO COR_FIN
      ASIGNACION BLOQUE_INI BLOQUE_FIN FIN_EXPR
      {: registrarSimbolo((String) id, tipo + "[]", idleft, "arreglo"); :}

    | VAL TIPO:tipo ID:id COR_INI TAMANO_ARREGLO COR_FIN
      ASIGNACION BLOQUE_INI LISTA_EXPRESIONES BLOQUE_FIN FIN_EXPR
      {: registrarSimbolo((String) id, tipo + "[]", idleft, "arreglo"); :}
    ;


/* ==========================================
   17. ACCESO A ARREGLOS
   ========================================== */

INDICE ::=
      EXPR_ARITMETICA:ea
      {: RESULT = ea; :}
    ;


ACCESO_ARREGLO ::=
      ID:id COR_INI INDICE COR_FIN
      {:
          validarIdentificador((String) id, idleft);
          TablaSimbolos.Simbolo simbolo = tablaSimbolos.buscarSimbolo((String) id);
          if (simbolo != null) {
              String tipo = simbolo.getTipo();
              // Eliminar los corchetes del tipo de arreglo
              if (tipo.endsWith("[]")) {
                  RESULT = tipo.substring(0, tipo.length() - 2);
              } else {
                  RESULT = tipo;
              }
          } else {
              RESULT = null;
          }
      :}
    ;


/* ==========================================
   18. ASIGNACION DE ARREGLOS
   ========================================== */

ASIGNACION_ARREGLO ::=
      ACCESO_ARREGLO ASIGNACION EXPRESION FIN_EXPR
    ;


/* ==========================================
   19. ENTRADA
   ========================================== */

SENTENCIA_READ ::=
      READ PAR_INI ID PAR_FIN FIN_EXPR
    ;


/* ==========================================
   20. SALIDA
   ========================================== */

OPERANDO_WRITE ::=
      ID
    | LIT_INT
    | LIT_FLOAT
    | LIT_BOOL
    | LIT_STRING
    ;


SENTENCIA_WRITE ::=
      WRITE PAR_INI OPERANDO_WRITE PAR_FIN FIN_EXPR
    ;


/* ==========================================
   21. RETURN Y BREAK
   ========================================== */

SENTENCIA_RETURN ::=
      RETURN EXPRESION FIN_EXPR
    ;


SENTENCIA_BREAK ::=
      BREAK FIN_EXPR
    ;


/* ==========================================
   22. IF - ELIF - ELSE
   ========================================== */

SENTENCIA_IF ::=
      IF PAR_INI EXPRESION PAR_FIN
      BLOQUE SENTENCIA_IF_RESTO
    ;


SENTENCIA_IF_RESTO ::=
      /* vacio */
    | SENTENCIA_ELIF_LISTA
    | ELSE BLOQUE
    | SENTENCIA_ELIF_LISTA ELSE BLOQUE
    ;


SENTENCIA_ELIF_LISTA ::=
      ELIF PAR_INI EXPRESION PAR_FIN BLOQUE
    ;

SENTENCIA_ELIF_LISTA ::=
      ELIF PAR_INI EXPRESION PAR_FIN
      BLOQUE SENTENCIA_ELIF_LISTA
    ;


/* ==========================================
   23. WHILE
   ========================================== */

SENTENCIA_WHILE ::=
      WHILE PAR_INI EXPRESION PAR_FIN BLOQUE
    ;


/* ==========================================
   24. FOR
   ========================================== */

SENTENCIA_FOR_INIT ::=
      DECLARACION_VAR_ASIGNADA
    ;

SENTENCIA_FOR_INIT ::=
      ASIGNACION_VAR
    ;


SENTENCIA_FOR_INCREMENTO ::=
      EXPR_INCREMENTO
    ;

SENTENCIA_FOR_INCREMENTO ::=
      EXPR_DECREMENTO
    ;

SENTENCIA_FOR_INCREMENTO ::=
      ASIGNACION_VAR_SIN_FIN
    ;


SENTENCIA_FOR ::=
      FOR PAR_INI SENTENCIA_FOR_INIT
      EXPRESION FIN_EXPR
      SENTENCIA_FOR_INCREMENTO PAR_FIN
      BLOQUE
    ;